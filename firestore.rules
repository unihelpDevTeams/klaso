rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUser(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isApprovedTutor() {
      return isSignedIn()
        && getUser(request.auth.uid).role == 'tutor'
        && getUser(request.auth.uid).approved == true;
    }

    function hasCoursePurchase(courseId) {
      let enrollmentPath = /databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId);
      return isSignedIn()
        && exists(enrollmentPath)
        && get(enrollmentPath).data.userId == request.auth.uid
        && get(enrollmentPath).data.courseId == courseId
        && get(enrollmentPath).data.status == 'active';
    }

    function isValidTutorProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'name', 'photoURL', 'bio', 'subject', 'education', 'experience',
          'hourlyRate', 'rating', 'reviewsCount', 'approved', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'name', 'photoURL', 'bio', 'subject', 'education', 'experience',
          'hourlyRate', 'rating', 'reviewsCount', 'approved', 'updatedAt'
        ])
        && data.uid == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.photoURL is string
        && data.photoURL.size() <= 2048
        && data.bio is string
        && data.bio.size() <= 2000
        && data.subject is string
        && data.subject.size() <= 120
        && data.education is string
        && data.education.size() <= 300
        && data.experience is string
        && data.experience.size() <= 300
        && (data.hourlyRate == null || data.hourlyRate is number)
        && (data.rating == null || data.rating is number)
        && (data.reviewsCount == null || data.reviewsCount is number)
        && data.approved is bool
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['student', 'tutor', 'admin']
        && (request.resource.data.role != 'admin' || isAdmin())
        && (request.resource.data.get('admin', false) != true || isAdmin())
        && (request.resource.data.get('approved', false) != true || isAdmin())
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.role != 'admin'
          && request.resource.data.get('admin', false) != true
          && (request.resource.data.get('approved', false) != true
            || resource.data.get('approved', false) == true));
      allow delete: if false;
    }

    match /tutorProfiles/{userId} {
      allow read: if resource.data.approved == true;
      allow create: if (isAdmin() && isValidTutorProfile(userId))
        || (isOwner(userId)
          && isApprovedTutor()
          && request.resource.data.approved == true
          && isValidTutorProfile(userId));
      allow update: if (isAdmin() && isValidTutorProfile(userId))
        || (isOwner(userId)
          && isApprovedTutor()
          && resource.data.approved == true
          && request.resource.data.approved == true
          && isValidTutorProfile(userId));
      allow delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isApprovedTutor())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.subject is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0
        && request.resource.data.createdAt is timestamp;
      allow update: if isSignedIn()
        && (isAdmin()
          || (resource.data.get('deletionStatus', '') != 'deleting'
            && request.resource.data.get('deletionStatus', '') == resource.data.get('deletionStatus', '')
            && request.auth.uid == resource.data.createdBy
            && request.resource.data.createdBy == resource.data.createdBy));
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isApprovedTutor())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.subject is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0
        && request.resource.data.createdAt is timestamp;
      allow update: if isSignedIn()
        && (isAdmin()
          || (resource.data.get('deletionStatus', '') != 'deleting'
            && request.resource.data.get('deletionStatus', '') == resource.data.get('deletionStatus', '')
            && request.auth.uid == resource.data.createdBy
            && request.resource.data.createdBy == resource.data.createdBy));
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if hasCoursePurchase(courseId)
          && reviewId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'courseId', 'userId', 'authorName', 'rating', 'comment', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.courseId == courseId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'senderId', 'senderName', 'recipientId', 'recipientName', 'text', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'senderId', 'senderName', 'recipientId', 'recipientName', 'text', 'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
